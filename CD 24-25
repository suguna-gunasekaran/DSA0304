#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

#define MAX 100

char input[MAX];
int pos = 0;

typedef struct Node {
    char value[20];
    struct Node *left;
    struct Node *right;
} Node;

Node* createNode(char *value, Node *left, Node *right) {
    Node *newNode = (Node*)malloc(sizeof(Node));

    strcpy(newNode->value, value);
    newNode->left = left;
    newNode->right = right;

    return newNode;
}

void skipSpaces() {
    while (input[pos] == ' ')
        pos++;
}

Node* E();

Node* F() {
    skipSpaces();

    if (input[pos] == '(') {
        pos++;

        Node *node = E();

        skipSpaces();

        if (input[pos] == ')') {
            pos++;
            return node;
        }

        printf("Error: Missing ')'\n");
        exit(1);
    }

    if (isdigit(input[pos])) {
        char number[20];
        int i = 0;

        while (isdigit(input[pos])) {
            number[i++] = input[pos++];
        }

        number[i] = '\0';

        return createNode(number, NULL, NULL);
    }

    printf("Error: Invalid expression\n");
    exit(1);
}

Node* T() {
    Node *left = F();

    while (1) {
        skipSpaces();

        if (input[pos] == '*' || input[pos] == '/') {
            char op[2];

            op[0] = input[pos];
            op[1] = '\0';

            pos++;

            Node *right = F();

            left = createNode(op, left, right);
        }
        else {
            break;
        }
    }

    return left;
}

Node* E() {
    Node *left = T();

    while (1) {
        skipSpaces();

        if (input[pos] == '+' || input[pos] == '-') {
            char op[2];

            op[0] = input[pos];
            op[1] = '\0';

            pos++;

            Node *right = T();

            left = createNode(op, left, right);
        }
        else {
            break;
        }
    }

    return left;
}

void printTree(Node *root, int level) {
    if (root == NULL)
        return;

    for (int i = 0; i < level; i++)
        printf("    ");

    printf("|-- %s\n", root->value);

    printTree(root->left, level + 1);
    printTree(root->right, level + 1);
}

int main() {
    Node *root;

    printf("Enter arithmetic expression: ");
    fgets(input, MAX, stdin);

    input[strcspn(input, "\n")] = '\0';

    root = E();

    skipSpaces();

    if (input[pos] != '\0') {
        printf("\nInvalid expression!\n");
        return 1;
    }

    printf("\nExpression parsed successfully.\n");

    printf("\nParse Tree:\n");
    printTree(root, 0);

    return 0;
}
