import re
 
# ---------------------------------------------------------------------
# Regular expression patterns
# ---------------------------------------------------------------------
REGISTER_NO_PATTERN = re.compile(r"^\d{2}\d{4}\d{3}$")                     # 9 digits total
INSTITUTIONAL_EMAIL_PATTERN = re.compile(r"^[\w.]+@[\w-]+\.ac\.in$", re.IGNORECASE)
COURSE_CODE_PATTERN = re.compile(r"^[A-Z]{2,4}\d{2,3}$")
SEMESTER_PATTERN = re.compile(r"^(?:semester\s*-?\s*([1-8])|sem\s*-?\s*([1-8])|([1-8])(?:st|nd|rd|th)\s*semester)$",
                               re.IGNORECASE)
MOBILE_PATTERN = re.compile(r"^(?:\+91[\s-]?)?[6-9]\d{9}$")
 
 
def validate_field(pattern, value):
    """Generic validator: returns True if value fully matches pattern."""
    return bool(pattern.match(value.strip()))
 
 
def validate_student(record):
    """Validates every field of a student record and returns a results dict."""
    results = {}
    results["Register Number"] = validate_field(REGISTER_NO_PATTERN, record["register_no"])
    results["Institutional Email"] = validate_field(INSTITUTIONAL_EMAIL_PATTERN, record["email"])
    results["Course Code"] = validate_field(COURSE_CODE_PATTERN, record["course_code"])
    results["Semester"] = validate_field(SEMESTER_PATTERN, record["semester"])
    results["Mobile Number"] = validate_field(MOBILE_PATTERN, record["mobile"])
    return results
 
 
def print_validation_report(name, record, results):
    print(f"\nStudent: {name}")
    print("-" * 50)
    for field, is_valid in results.items():
        status = "VALID" if is_valid else "INVALID"
        print(f"  {field:<22}: {record_value(record, field):<25} -> {status}")
 
    overall = all(results.values())
    print(f"  {'-'*46}")
    print(f"  Registration Status : {'SUCCESSFUL' if overall else 'FAILED'}")
    return overall
 
 
def record_value(record, field):
    mapping = {
        "Register Number": record["register_no"],
        "Institutional Email": record["email"],
        "Course Code": record["course_code"],
        "Semester": record["semester"],
        "Mobile Number": record["mobile"],
    }
    return mapping[field]
 
 
# ---------------------------------------------------------------------
# Sample student registration submissions
# ---------------------------------------------------------------------
students = [
    {
        "name": "Priya Sharma",
        "register_no": "192211045",
        "email": "priya.sharma@saveetha.ac.in",
        "course_code": "DSA03",
        "semester": "Semester 5",
        "mobile": "9876543210",
    },
    {
        "name": "Karthik Iyer",
        "register_no": "22CS1123",       # invalid format (letters mixed in)
        "email": "karthik.iyer@gmail.com",   # not an institutional email
        "course_code": "cs101",              # lowercase, invalid format
        "semester": "9th Semester",          # out of range
        "mobile": "12345",                   # invalid mobile
    },
]
 
 
def main():
    print("=" * 55)
    print(" UNIVERSITY REGISTRATION VALIDATION SYSTEM")
    print("=" * 55)
 
    summary = []
    for student in students:
        results = validate_student(student)
        overall = print_validation_report(student["name"], student, results)
        summary.append((student["name"], overall))
 
    print("\n" + "=" * 55)
    print(" FINAL REGISTRATION STATUS REPORT")
    print("=" * 55)
    for name, overall in summary:
        print(f"  {name:<20}: {'SUCCESSFUL' if overall else 'FAILED'}")
 
 
if __name__ == "__main__":
    main()
